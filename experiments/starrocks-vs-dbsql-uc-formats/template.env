# Copy to dev.env (gitignored) and fill in. Real environment variables win.

# --- Databricks ---
# OAuth profile in ~/.databrickscfg (SSO — never a PAT)
DATABRICKS_CONFIG_PROFILE=DEFAULT
# UC catalog + schema the evaluation writes into (schema is created by 00_setup_uc.py)
UC_CATALOG=my_catalog
UC_SCHEMA=starrocks_uc_eval
# Serverless SQL warehouse id (Admin console -> SQL warehouses -> connection details)
DATABRICKS_WAREHOUSE_ID=0123456789abcdef

# --- StarRocks (from `make tf-apply` outputs) ---
STARROCKS_HOST=203.0.113.10
STARROCKS_PORT=9030
STARROCKS_USER=root
STARROCKS_PASSWORD=

# --- Battery shape ---
ROW_COUNT=100000
AGG_RUNS=7

# --- Cost model (documented assumptions; override to your rates) ---
# m5.2xlarge us-east-1 on-demand
STARROCKS_EC2_USD_PER_HOUR=0.384
# AWS serverless SQL list price
DBSQL_USD_PER_DBU=0.70
# 0 = look the warehouse size up live and map size -> DBU/hr
DBSQL_WAREHOUSE_DBU_PER_HOUR=0
