# Databricks CLI profile authenticated with OAuth/SSO. PATs are refused.
DATABRICKS_CONFIG_PROFILE=DEFAULT
# Catalog where the experiment may create and drop its schema.
EXPERIMENT_CATALOG=my_catalog
# Isolated schema name; the cleanup target drops it with CASCADE.
EXPERIMENT_SCHEMA=uc_managed_exit_experiment
# Serverless SQL warehouse used for every live statement.
EXPERIMENT_WAREHOUSE_ID=
# Writable external location root. Use a dedicated subdirectory; no trailing slash.
EXPERIMENT_EXTERNAL_ROOT=s3://my-experiment-bucket/uc-managed-exit
