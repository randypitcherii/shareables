# Databricks CLI profile authenticated with OAuth/SSO. PATs are refused.
DATABRICKS_CONFIG_PROFILE=DEFAULT
# Serverless SQL warehouse used for every UC statement.
EXPERIMENT_WAREHOUSE_ID=
# Writable UC external location subdirectory in YOUR S3 bucket; no trailing slash.
# The experiment creates a catalog with storage root <EXTERNAL_ROOT>/managed-catalog-root.
EXPERIMENT_EXTERNAL_ROOT=s3://my-experiment-bucket/uc-managed-exit
# Temporary isolated UC catalog; cleanup drops it with CASCADE.
EXPERIMENT_MANAGED_CATALOG=uc_managed_exit_experiment
# AWS SSO profile that can read/write the bucket directly (the non-UC clients use it).
AWS_PROFILE=my-aws-sso-profile
AWS_REGION=us-east-1
