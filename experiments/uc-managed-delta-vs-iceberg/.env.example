# Databricks CLI profile authenticated with OAuth/SSO. PATs are refused.
DATABRICKS_CONFIG_PROFILE=DEFAULT
# Serverless SQL warehouse used for setup and Databricks-side read-back.
EXPERIMENT_WAREHOUSE_ID=
# Writable path under a UC external location in YOUR bucket; becomes the catalog's managed
# location. Must NOT be Default Storage (credential vending to external engines needs it).
EXPERIMENT_STORAGE_ROOT=s3://my-experiment-bucket/uc-delta-vs-iceberg
# Temporary isolated catalog; `make cleanup` drops it with CASCADE.
EXPERIMENT_CATALOG=uc_delta_vs_iceberg_experiment
# Region of the bucket (DuckDB's unity_catalog secret needs it explicitly).
AWS_REGION=us-east-1
# Job cluster used for rows 02-04 (automatic CDF needs DBR 19+).
EXPERIMENT_SPARK_VERSION=19.x-scala2.13
EXPERIMENT_NODE_TYPE=m5d.xlarge
