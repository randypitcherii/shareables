{
  "datasets": [
    {
      "name": "seconds_long",
      "displayName": "Probe: per-second series",
      "queryLines": [
        "SELECT run_id, endpoint, workspace, t, series, value FROM __FQ__.v_probe_seconds_long"
      ]
    },
    {
      "name": "seconds",
      "displayName": "Probe: per-second latency",
      "queryLines": [
        "SELECT run_id, endpoint, workspace, t, s.series, s.ms FROM __FQ__.v_probe_seconds LATERAL VIEW STACK(2, 'p50', p50_ms, 'p95', p95_ms) s AS series, ms"
      ]
    },
    {
      "name": "steps",
      "displayName": "Probe: 429 share by target rate",
      "queryLines": [
        "SELECT run_id, endpoint, workspace, target_rate, throttled_share, p50_ms, CONCAT(endpoint, ' / ws ', workspace) AS endpoint_ws FROM __FQ__.v_probe_steps"
      ]
    },
    {
      "name": "onset",
      "displayName": "Probe: onset per endpoint",
      "queryLines": [
        "SELECT run_id, endpoint, workspace, first_429_rate, onset_rate, peak_target_rate FROM __FQ__.v_probe_onset ORDER BY endpoint, workspace"
      ]
    },
    {
      "name": "audit",
      "displayName": "Audit: Iceberg REST calls per minute",
      "queryLines": [
        "SELECT minute, CONCAT(service_name, '.', action_name) AS action, status_code, calls, peak_qps FROM __FQ__.v_iceberg_rest_audit"
      ]
    },
    {
      "name": "audit_status",
      "displayName": "Audit: Iceberg REST calls by status",
      "queryLines": [
        "SELECT minute, CAST(status_code AS STRING) AS status_code, SUM(calls) AS calls FROM __FQ__.v_iceberg_rest_audit WHERE service_name = 'uniformIcebergRestCatalog' GROUP BY ALL"
      ]
    },
    {
      "name": "audit_failures",
      "displayName": "Audit: Iceberg REST failures",
      "queryLines": [
        "SELECT event_time, action_name, status_code, error_message, user_agent FROM __FQ__.v_iceberg_rest_audit_failures ORDER BY event_time DESC LIMIT 500"
      ]
    }
  ],
