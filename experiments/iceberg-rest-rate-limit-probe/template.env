# Copy to dev.env (gitignored) and fill in. Loaded by scripts/_common.py via APP_ENV
# (APP_ENV=dev -> dev.env). Real environment variables win over the file.
#
# Point these ONLY at freshly provisioned, transient sandbox workspaces you own.
# This experiment deliberately drives the Iceberg REST catalog into 429s.

# --- Workspace A (primary) ---
DATABRICKS_PROFILE_A=probe-a
# --- Workspace B (optional; same metastore as A for the scope test) ---
DATABRICKS_PROFILE_B=

# Environment stamp written into every result (no hostnames or IDs).
PROBE_CLOUD=aws
PROBE_REGION=us-east-1

# --- Unity Catalog objects the probe creates (setup) and drops (cleanup) ---
UC_CATALOG=<catalog-you-own-in-A>
UC_CATALOG_B=<catalog-you-own-in-B>
UC_SCHEMA=iceberg_rest_probe
PROBE_TABLE_COUNT=50
DATABRICKS_WAREHOUSE_ID=<serverless-warehouse-id-in-A>
DATABRICKS_WAREHOUSE_ID_B=<serverless-warehouse-id-in-B>

# --- Safety bounds (the probe refuses to exceed these) ---
PROBE_MAX_RATE=1000          # hard peak request rate, req/s per workspace
PROBE_MAX_DURATION_SEC=900   # hard wall-clock cap per probe run
PROBE_MAX_CONCURRENCY=250    # in-flight requests per workspace (see README: more is not better)

RUN_ID=dev-run
