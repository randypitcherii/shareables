    {
      "dot": "cyan",
      "title": "Measured (sandbox, Nov 2026)",
      "items": [
        "loadTable: clean to 300/s, 429 at 350/s per workspace",
        "config 429 at 200/s; /credentials at 50/s",
        "listTables ~50/s, then slows (117ms to 8s), no 429",
        "2 workspaces: ~400/s combined, not 300 each",
        "Recovery 0-1s; per-workspace 429 sends Retry-After: 1"
      ]
    },
    {
      "dot": "rose",
      "title": "Production risks",
      "items": [
        "30s refresh x large estate exceeds the edge limit",
        "Snowflake JIT refresh (preview) adds query-time calls",
        "Azure: no Entra sign-in over Private Link",
        "Per-workspace 429s are invisible in the audit log",
        "Shared-limit 429s send no Retry-After"
      ]
    },
    {
      "dot": "amber",
      "title": "Sizing rule",
      "items": [
        "loadTable/s ~ active tables / refresh seconds",
        "10k tables @ 30s = 333/s (over); @ 120s = 83/s",
        "Size for peak: keep it under ~300/s per workspace, ~400/s per metastore"
      ]
    }
