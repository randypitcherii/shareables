# Copy to dev.env (gitignored) and fill in. Loaded by scripts/_common.py via APP_ENV
# (APP_ENV=dev -> dev.env). Real environment variables win over the file.

# --- Pulsar (from `terraform output`) ---
PULSAR_SERVICE_URL=pulsar://<vm-public-ip>:6650
PULSAR_ADMIN_URL=http://<vm-public-ip>:8080
KAFKA_BOOTSTRAP=<vm-public-ip>:9092
PULSAR_TOPIC=persistent://public/default/uc-scale-eval
# SSH for the on-VM producer (host = the VM public IP; key = your private key path)
SSH_HOST=<vm-public-ip>
SSH_KEY=~/.ssh/id_ed25519

# --- Databricks ---
DATABRICKS_CONFIG_PROFILE=DEFAULT
UC_CATALOG=<your-catalog>
UC_SCHEMA=pulsar_uc_scale_eval
DATABRICKS_WAREHOUSE_ID=<warehouse-id-for-verification-queries>

# --- Workload shape (override per run) ---
EVENT_COUNT=2000000
EVENT_RATE_PER_SEC=0         # 0 = as fast as the producer sustains
RUN_ID=dev-run
