# Copy to dev.env (gitignored) and fill in. Real environment variables win.

# --- Databricks ---
# OAuth/SSO profile in ~/.databrickscfg — never a PAT (helpers refuse dapi tokens)
DATABRICKS_CONFIG_PROFILE=DEFAULT
# Serverless SQL warehouse id (SQL warehouses -> connection details)
DATABRICKS_WAREHOUSE_ID=0123456789abcdef
# Names of the UC objects 00_setup_uc.py creates (defaults are fine)
UC_FOREIGN_CATALOG=glue_iceberg_list_eval
UC_CONNECTION=glue_iceberg_list_eval_conn
UC_SERVICE_CREDENTIAL=glue_iceberg_list_eval_svc
UC_STORAGE_CREDENTIAL=glue_iceberg_list_eval_stg
UC_EXTERNAL_LOCATION=glue_iceberg_list_eval_loc
# Optional: a writable catalog.schema for row 08's bypass attempts
# UC_BYPASS_CATALOG=my_catalog
# UC_BYPASS_SCHEMA=scratch

# --- AWS (paste from `make tf-apply` env_snippet) ---
AWS_PROFILE=your-aws-sso-profile
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=000000000000
S3_BUCKET=glue-iceberg-list-eval-000000000000-us-east-1
GLUE_DATABASE=glue_iceberg_list_eval
UC_FEDERATION_ROLE_ARN=arn:aws:iam::000000000000:role/glue-iceberg-list-eval-uc-federation
ATHENA_WORKGROUP=glue-iceberg-list-eval-athena

# --- Shape ---
# Prefix for every experiment table name in Glue
TABLE_PREFIX=t
