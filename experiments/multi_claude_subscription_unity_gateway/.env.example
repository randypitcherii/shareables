# Databricks CLI OAuth profile (databricks auth login --host <workspace-url> --profile <name>)
DATABRICKS_CONFIG_PROFILE=DEFAULT

# Catalog for the schema. Needs its own storage root (inference tables land there).
CATALOG=main

# dev (default) or rollout
TARGET=dev

# Optional: SQL warehouse for row 07 (defaults to the first serverless warehouse)
WAREHOUSE_ID=
