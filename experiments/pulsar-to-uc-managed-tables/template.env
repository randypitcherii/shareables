# Copy to dev.env (gitignored) and fill in. Loaded by scripts/_common.py via APP_ENV
# (APP_ENV=dev -> dev.env). See the env-preferences pattern.

# --- Pulsar (from `terraform output`) ---
PULSAR_SERVICE_URL=pulsar://<vm-public-ip>:6650
PULSAR_ADMIN_URL=http://<vm-public-ip>:8080
KAFKA_BOOTSTRAP=<vm-public-ip>:9092
PULSAR_TOPIC=persistent://public/default/uc-ingest-eval

# --- Databricks ---
DATABRICKS_CONFIG_PROFILE=DEFAULT
UC_CATALOG=rpw_prod
UC_SCHEMA=pulsar_uc_ingest_eval
DATABRICKS_WAREHOUSE_ID=<warehouse-id-for-verification-queries>

# --- Workload shape (generic defaults; override per run) ---
EVENT_COUNT=100000
EVENT_RATE_PER_SEC=5000
EVENT_PAYLOAD_BYTES=512
