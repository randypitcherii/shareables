# ── House theme: Mono Bold. Copy verbatim. ──
**.style: {
  fill: "#FFFFFF"
  stroke: "#000000"
  stroke-width: 1
  font-color: "#000000"
  bold: true
  border-radius: 4
}
(** -> **)[*].style: {
  stroke: "#000000"
  stroke-width: 1
  font-color: "#000000"
  bold: true
  italic: false
}

direction: down

paths: "Paths A-E: route and verdict" {
  style.border-radius: 0
  style.fill: "#FFFFFF"
  grid-columns: 1
  grid-gap: 20

  A: "A -- KoP -> Databricks Kafka source -> managed Delta\nGA end-to-end, but KoP is archived, pinned to Pulsar 3.1.1"
  B: "B -- native pulsar connector -> managed Delta\nWorks; source is Public Preview"
  C: "C -- Pulsar consumer -> PyIceberg -> UC REST -> managed Iceberg\nGA; no Databricks compute in ingest path"
  D: "D -- KoP -> Kafka Connect Iceberg sink -> UC REST\nDocumented, not run"
  E: "E -- pulsar-io-lakehouse sink connector\nDisqualified: Iceberg mode has no REST catalog support" {
    style.fill: "#F2F2F2"
  }
}

