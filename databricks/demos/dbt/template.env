# Copy this file to `.env` and fill in the REQUIRED values. `.env` is gitignored.
#
# Loading: dbt Core v1.12+ (what this project pins via dbt-databricks) auto-loads
# `.env` from the current directory -- no sourcing needed. Non-dbt tools reading
# these vars (or an older dbt) still need: set -a; source .env; set +a
#
# -----------------------------------------------------------------------------
# REQUIRED for every target (no in-repo fallback -- workspace-specific, and we
# don't publish internal infrastructure identifiers):
# -----------------------------------------------------------------------------
DBT_HOST=your-workspace.cloud.databricks.com
DBT_HTTP_PATH=/sql/1.0/warehouses/your_sql_warehouse_id

# -----------------------------------------------------------------------------
# OPTIONAL dev overrides (these DO have safe in-repo fallbacks):
# -----------------------------------------------------------------------------
# DBT_DEPLOYMENT_ENVIRONMENT=development          # development | ci_testing | production
# DBT_DEFAULT_CATALOG=analytics_dev              # default; set to your own catalog
# DBT_DEFAULT_SCHEMA=dbt
# DBT_DEV_USER=your_name                          # else derived from OS $USER -> dbt_<user>
# DBT_USAGE_HISTORY_DAYS=14                        # smaller = faster demo builds (default 90)

# -----------------------------------------------------------------------------
# CI / PROD only -- normally you NEVER set this by hand: the ci/prod targets run
# inside serverless Databricks job tasks, where scripts/databricks_dbt_runner.py
# resolves a short-lived token from the job's run_as identity at runtime. Set it
# manually only to exercise the ci/prod targets from a laptop (e.g. a token from
# `databricks auth token`). The DBT_ENV_SECRET_ prefix makes dbt mask it in logs
# and forbid it outside profiles.yml.
# -----------------------------------------------------------------------------
# DBT_ENV_SECRET_DATABRICKS_TOKEN=...
