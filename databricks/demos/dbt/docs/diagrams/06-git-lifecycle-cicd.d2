# ── House theme: Mono Bold. Copy verbatim. ──
**.style: {
  fill: "#FFFFFF"
  stroke: "#000000"
  stroke-width: 1
  font-color: "#000000"
  bold: true
  border-radius: 4
}
(** -> **)[*].style: {
  stroke: "#000000"
  stroke-width: 1
  font-color: "#000000"
  bold: true
  italic: false
}

direction: down

events: Git events {
  style.border-radius: 0
  pr: PR opened / updated
  merge: merge to main\n(dbt paths only)
  cron: schedule
}

gha: GitHub Actions {
  label.near: outside-top-left
  style.border-radius: 0
  note: trigger + poll only\nno dbt on the runner { style.fill: "#F2F2F2" }
  ci_wf: dbt-ci.yml\nfork-PR guards
  cd_wf: dbt-cd.yml
}

jobs: Databricks jobs {
  label.near: outside-top-left
  style.border-radius: 0
  identity: serverless\nrun_as dbt_prod_sp { style.fill: "#F2F2F2" }
  ci: dbt CI
  cd: dbt CD { style.fill: "#FFE066" }
  daily: dbt Daily
  hourly: dbt Hourly (paused) { style.fill: "#F2F2F2" }
}

targets: What each run touches {
  label.near: outside-bottom-center
  style.border-radius: 0
  ci_schema: pr<N>_build<N> schema\n(ephemeral)
  bundle: DAB resources\njobs · schema · volume · docs app
  prod: prod schemas\n+ captured state & docs
}

events.pr -> gha.ci_wf
events.merge -> gha.cd_wf
events.cron -> jobs.daily
events.cron -> jobs.hourly: { style.stroke-dash: 4 }

gha.ci_wf -> jobs.ci: run-now @ PR SHA
gha.cd_wf -> jobs.cd: run-now @ merge SHA

jobs.ci -> targets.ci_schema: build then cleanup
jobs.cd -> targets.bundle: bundle deploy
jobs.cd -> targets.prod: slim build
jobs.daily -> targets.prod: tag:daily
jobs.hourly -> targets.prod: tag:hourly { style.stroke-dash: 4 }
