{
  "datasets": [
    {
      "name": "latest",
      "displayName": "Latest findings",
      "queryLines": [
        "SELECT workspace_id, control_name, tier, domain,\n",
        "       CASE status WHEN 'PASS' THEN '1 In place' WHEN 'PARTIAL' THEN '2 Partial' WHEN 'FAIL' THEN '3 Needs attention' WHEN 'NOT_APPLICABLE' THEN '5 Not applicable' ELSE '4 Not evaluated' END AS status,\n",
        "       CAST(tier = 'essential' AND status = 'FAIL' AS INT) AS failing_essential,\n",
        "       CAST(tier = 'credential_hygiene' AND status IN ('FAIL', 'PARTIAL') AS INT) AS hygiene_gap,\n",
        "       round(adoption_pct, 1) AS adoption_pct, source, detail, snapshot_ts\n",
        "FROM rpw_security_infra_latest\n",
        "ORDER BY status DESC, tier, control_name, workspace_id\n"
      ]
    },
    {
      "name": "trend",
      "displayName": "Trend",
      "queryLines": [
        "SELECT date_trunc('DAY', snapshot_ts) AS day, control_name,\n",
        "       count(DISTINCT CASE WHEN status = 'FAIL' THEN workspace_id END) AS failing_workspaces\n",
        "FROM rpw_security_infra_findings WHERE tier = 'essential' GROUP BY ALL\n"
      ]
    },
    {
      "name": "changes",
      "displayName": "Changes",
      "queryLines": [
        "SELECT snapshot_ts, workspace_id, control_name,\n",
        "       CASE prev_status WHEN 'PASS' THEN '1 In place' WHEN 'PARTIAL' THEN '2 Partial' WHEN 'FAIL' THEN '3 Needs attention' WHEN 'NOT_APPLICABLE' THEN '5 Not applicable' ELSE '4 Not evaluated' END AS prev_status,\n",
        "       CASE status WHEN 'PASS' THEN '1 In place' WHEN 'PARTIAL' THEN '2 Partial' WHEN 'FAIL' THEN '3 Needs attention' WHEN 'NOT_APPLICABLE' THEN '5 Not applicable' ELSE '4 Not evaluated' END AS status, detail\n",
        "FROM rpw_security_infra_changes ORDER BY snapshot_ts DESC\n"
      ]
    }
  ],
