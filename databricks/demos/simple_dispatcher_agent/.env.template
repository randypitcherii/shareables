# Copy to .env and fill in. The real .env is gitignored.
#
# Auth is opinionated and PAT-free:
#   - Local dev: user SSO via `databricks auth login` + a CLI profile below.
#   - CI / prod jobs: service principal creds (DATABRICKS_CLIENT_ID /
#     DATABRICKS_CLIENT_SECRET) injected by the environment.
#   - Deployed serving endpoint: the CALLER's identity (on-behalf-of-user), no creds.
# The code never branches on auth type. It relies on SDK default credential
# resolution. DATABRICKS_TOKEN (PATs) are intentionally NOT supported.

# --- Auth (local dev) -------------------------------------------------------
DATABRICKS_CONFIG_PROFILE=DEFAULT

# --- Models (all optional: these are the defaults) --------------------------
# Three-part Unity Catalog ids, called through Unity AI Gateway (/ai-gateway/*).
LUNA_MODEL=system.ai.gpt-6-luna
OPUS_MODEL=system.ai.claude-opus-5-5
# Newest Gemini served on fe-vm; use system.ai.gemini-4-argon where rolled out.
GEMINI_MODEL=system.ai.gemini-3-8-flash
# OpenJev; switch to system.ai.typesafeai-jev-1-14-0 (Jev) once it is served here.
JEV_MODEL=system.ai.openjev-qwen35-4b
# Below this JEV confidence, the request goes to luna (the default).
ROUTER_MIN_CONFIDENCE=0.5

# --- Tracing (optional) -----------------------------------------------------
# MLflow experiment path for traces, e.g. /Users/<you>/simple_dispatcher_agent.
# Set BASE_CATALOG/BASE_SCHEMA too to store the traces in UC Delta tables.
MLFLOW_EXPERIMENT=
BASE_CATALOG=
BASE_SCHEMA=simple_dispatcher
